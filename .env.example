# ─────────────────────────────────────────────────────────────────────
# RentBuster configuration
# Copy this file to `.env` and fill in the values you need.
# Each value below is optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────

# ── Profile ─────────────────────────────────────────────────────────
# Which search profile to use. Built-ins: amsterdam
PROFILE=amsterdam


# ── Database (REQUIRED for persistence, Telegram subscribers, dashboard) ──
# Leave unset to run without persistence. It will fetch and log results
# but won't remember what it's seen across runs.
DATABASE_URL=postgres://rentbuster:rentbuster@localhost:5432/rentbuster


# ── Sources ─────────────────────────────────────────────────────────
# Pararius: Playwright-based (headless Chromium). Slower but richest data.
PARARIUS_ENABLED=true
PARARIUS_MAX_PAGES=5
PLAYWRIGHT_HEADLESS=true
FETCH_DETAILS=true          # visit detail pages for postal code, energy label, etc.
DETAIL_FETCH_DELAY=2.0      # seconds between detail page fetches (be polite)

# Rent-buster.nl: lightweight HTTP scraper. Faster, includes pre-computed max rents.
RENTBUSTER_NL_ENABLED=true
RENTBUSTER_NL_MAX_PAGES=10


# ── WWS filtering ───────────────────────────────────────────────────
# Only notify for listings where asking rent > legal maximum.
WWS_BUSTABLE_ONLY=true
# Minimum monthly savings (EUR) to trigger a notification.
WWS_MIN_SAVINGS=50


# ── Notifications: Discord ──────────────────────────────────────────
# Create a webhook: Server Settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=


# ── Notifications: Telegram ─────────────────────────────────────────
# Create a bot via @BotFather. Both variables required together.
# Users subscribe by sending /start <password> to your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PASSWORD=


# ── Notifications: Apprise (100+ channels) ──────────────────────────
# Comma-separated Apprise URLs. Syntax: https://github.com/caronc/apprise/wiki
# Examples: ntfy://mytopic  |  slack://TokenA/TokenB/TokenC  |  pover://USER@APP
APPRISE_URLS=


# ── LLM feature extraction (optional) ──────────────────────────────
# Uses Gemini Flash to analyze listing descriptions for outdoor space,
# kitchen, bathroom, and heating details — replacing conservative defaults.
# Requires: uv sync --extra llm (or pip install google-genai)
LLM_ENABLED=false
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash


# ── Scheduling ──────────────────────────────────────────────────────
# Seconds between scrape cycles (randomized). Playwright is heavy; longer = safer.
CHECK_INTERVAL_MIN=120
CHECK_INTERVAL_MAX=300


# ── User agent ──────────────────────────────────────────────────────
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
